{
  "permissions": {
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run validate:*)",
      "Bash(npm run route:*)",
      "Bash(node scripts/validate-graph.mjs:*)",
      "Bash(node scripts/route.ts:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/validate-on-data-edit.mjs\""
          }
        ]
      }
    ]
  }
}
