{
  "name": "inha-5-indoor-nav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run data && vite",
    "start": "npm run dev",
    "build": "npm run data && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node scripts/deploy-pages.mjs",
    "data": "node scripts/build-data.mjs",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-graph.mjs",
    "route": "node scripts/route.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
